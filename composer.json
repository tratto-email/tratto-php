{
    "name": "tratto/email",
    "description": "Official PHP SDK for the Tratto email API",
    "type": "library",
    "license": "MIT",
    "keywords": ["email", "transactional", "tratto", "api", "sdk"],
    "homepage": "https://tratto.email",
    "support": {
        "issues": "https://github.com/tratto-email/tratto-php/issues",
        "source": "https://github.com/tratto-email/tratto-php",
        "docs": "https://docs.tratto.email"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5"
    },
    "autoload": {
        "psr-4": {
            "Tratto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tratto\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
